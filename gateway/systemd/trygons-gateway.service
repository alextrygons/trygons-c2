[Unit]
Description=Trygons C2 gateway (AURIX <-> boat LAN / VPN) - gateway PC, Ubuntu 24.04 LTS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trygons
ExecStart=/usr/bin/python3 /home/trygons/trygons-c2/gateway/gateway.py --config /etc/trygons/gateway.json
Restart=always
RestartSec=2
# setting the clock from GPS is the only privileged thing it does
AmbientCapabilities=CAP_SYS_TIME
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=yes
# the USB-UART adapter (AURIX) and the USB AIS receiver
SupplementaryGroups=dialout
ProtectSystem=strict
# data on the PC's own SSD (/var/lib/trygons); "-" = an optional external SSD
ReadWritePaths=/etc/trygons /var/lib/trygons -/mnt/ssd
StateDirectory=trygons
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
